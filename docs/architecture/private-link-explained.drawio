<mxfile host="drawio" agent="draw.io"><diagram id="pl" name="Private Link explained"><mxGraphModel dx="1160" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pl-1" value="1  Private endpoint (inbound) — how clients reach Foundry, Storage, Cosmos DB and Search in this reference" style="fontSize=16;fontStyle=1;fontFamily=Segoe UI;fillColor=none;strokeColor=none;align=left;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1120" height="30" as="geometry"/></mxCell><mxCell id="pl-2" value="Your VNet (customer owned)" style="rounded=1;absoluteArcSize=1;arcSize=14;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;whiteSpace=wrap;fillColor=#f4f8fe;strokeColor=#1565c0;strokeWidth=2;fontFamily=Segoe UI;fontSize=12;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="470" height="170" as="geometry"/></mxCell><mxCell id="pl-3" value="&lt;b&gt;Jumpbox / agent runtime&lt;/b&gt;&lt;br&gt;resolves &amp;lt;account&amp;gt;.openai.azure.com&lt;br&gt;→ 10.80.1.5 (private DNS)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;fillColor=#fff8e1;strokeColor=#c49000;fontFamily=Segoe UI;fontSize=12;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="115" width="200" height="75" as="geometry"/></mxCell><mxCell id="pl-4" value="&lt;b&gt;Private endpoint&lt;/b&gt;&lt;br&gt;NIC with private IP&lt;br&gt;10.80.1.5 in snet-private-endpoints" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;fillColor=#fff8e1;strokeColor=#c49000;fontFamily=Segoe UI;fontSize=12;html=1;" vertex="1" parent="1"><mxGeometry x="270" y="115" width="200" height="75" as="geometry"/></mxCell><mxCell id="pl-5" value="&lt;b&gt;Private endpoint connection&lt;/b&gt;&lt;br&gt;state: &lt;b&gt;Approved&lt;/b&gt; (automatic)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontFamily=Segoe UI;fontSize=12;html=1;" vertex="1" parent="1"><mxGeometry x="560" y="125" width="210" height="55" as="geometry"/></mxCell><mxCell id="pl-6" value="&lt;b&gt;Target resource&lt;/b&gt; (e.g. Foundry)&lt;br&gt;public network access: &lt;b&gt;Disabled&lt;/b&gt;&lt;br&gt;accepts only approved connections" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontFamily=Segoe UI;fontSize=12;html=1;" vertex="1" parent="1"><mxGeometry x="860" y="110" width="270" height="85" as="geometry"/></mxCell><mxCell id="pl-7" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#37474f;" edge="1" parent="1" source="pl-3" target="pl-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pl-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#37474f;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pl-4" target="pl-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pl-9" value="Private Link" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#37474f;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pl-5" target="pl-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pl-10" value="Approved automatically because whoever creates the endpoint also has the approval permission on the target (same subscription / owner)." style="fontSize=12;fontFamily=Segoe UI;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="560" y="195" width="570" height="40" as="geometry"/></mxCell><mxCell id="pl-11" value="2  Shared private link (outbound from AI Search) — Foundry IQ query planning (model), knowledge sources on Blob / ADLS / SQL" style="fontSize=16;fontStyle=1;fontFamily=Segoe UI;fillColor=none;strokeColor=none;align=left;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="270" width="1120" height="30" as="geometry"/></mxCell><mxCell id="pl-12" value="Microsoft-managed network and tenant of the AI Search service (not your VNet)" style="rounded=1;absoluteArcSize=1;arcSize=14;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#757575;strokeWidth=2;dashed=1;fontFamily=Segoe UI;fontSize=12;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="470" height="170" as="geometry"/></mxCell><mxCell id="pl-13" value="&lt;b&gt;AI Search&lt;/b&gt;&lt;br&gt;knowledge base (query planning)&lt;br&gt;or generated indexer (ingestion)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;fillColor=#fff8e1;strokeColor=#c49000;fontFamily=Segoe UI;fontSize=12;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="365" width="200" height="75" as="geometry"/></mxCell><mxCell id="pl-14" value="&lt;b&gt;Managed private endpoint&lt;/b&gt;&lt;br&gt;created by Search when you&lt;br&gt;add a shared private link" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;fillColor=#fff8e1;strokeColor=#c49000;fontFamily=Segoe UI;fontSize=12;html=1;" vertex="1" parent="1"><mxGeometry x="270" y="365" width="200" height="75" as="geometry"/></mxCell><mxCell id="pl-15" value="&lt;b&gt;Private endpoint connection&lt;/b&gt;&lt;br&gt;state: &lt;b&gt;Pending&lt;/b&gt; → target owner&lt;br&gt;selects &lt;b&gt;Approve&lt;/b&gt; (or Reject)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;fontFamily=Segoe UI;fontSize=12;html=1;" vertex="1" parent="1"><mxGeometry x="560" y="370" width="210" height="65" as="geometry"/></mxCell><mxCell id="pl-16" value="&lt;b&gt;Target resource + group ID&lt;/b&gt;&lt;br&gt;Foundry: &lt;code&gt;openai_account&lt;/code&gt; / &lt;code&gt;foundry_account&lt;/code&gt;&lt;br&gt;Storage: &lt;code&gt;blob&lt;/code&gt; / &lt;code&gt;dfs&lt;/code&gt; · SQL: &lt;code&gt;sqlServer&lt;/code&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontFamily=Segoe UI;fontSize=12;html=1;" vertex="1" parent="1"><mxGeometry x="860" y="360" width="270" height="85" as="geometry"/></mxCell><mxCell id="pl-17" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#37474f;" edge="1" parent="1" source="pl-13" target="pl-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pl-18" value="request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#37474f;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pl-14" target="pl-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pl-19" value="Private Link" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#37474f;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pl-15" target="pl-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pl-20" value="&lt;b&gt;Why approval?&lt;/b&gt; The endpoint is created in a Microsoft-managed tenant the target owner doesn't control. Anyone who knows a resource ID can request a connection; approval is the owner's consent to &lt;i&gt;which network&lt;/i&gt; may connect. Identity (managed identity + RBAC) is still checked on every call. One link per target and group ID." style="fontSize=12;fontFamily=Segoe UI;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="560" y="445" width="570" height="75" as="geometry"/></mxCell><mxCell id="pl-21" value="3  For contrast: trusted-service exception — not Private Link" style="fontSize=16;fontStyle=1;fontFamily=Segoe UI;fillColor=none;strokeColor=none;align=left;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="1120" height="30" as="geometry"/></mxCell><mxCell id="pl-22" value="Microsoft-managed network of the AI Search service" style="rounded=1;absoluteArcSize=1;arcSize=14;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#757575;strokeWidth=2;dashed=1;fontFamily=Segoe UI;fontSize=12;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="610" width="470" height="130" as="geometry"/></mxCell><mxCell id="pl-23" value="&lt;b&gt;AI Search&lt;/b&gt; (system-assigned MI)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;fillColor=#fff8e1;strokeColor=#c49000;fontFamily=Segoe UI;fontSize=12;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="655" width="200" height="50" as="geometry"/></mxCell><mxCell id="pl-24" value="&lt;b&gt;Public endpoint&lt;/b&gt; of the target&lt;br&gt;Foundry: &lt;code&gt;bypass: AzureServices&lt;/code&gt;&lt;br&gt;Storage: trusted Microsoft services" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;fontFamily=Segoe UI;fontSize=12;html=1;" vertex="1" parent="1"><mxGeometry x="560" y="645" width="210" height="70" as="geometry"/></mxCell><mxCell id="pl-25" value="&lt;b&gt;Target resource&lt;/b&gt;&lt;br&gt;public access restricted, but trusted&lt;br&gt;Azure services are let through" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontFamily=Segoe UI;fontSize=12;html=1;" vertex="1" parent="1"><mxGeometry x="860" y="645" width="270" height="70" as="geometry"/></mxCell><mxCell id="pl-26" value="managed identity token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#37474f;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pl-23" target="pl-24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pl-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#37474f;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pl-24" target="pl-25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pl-28" value="No endpoint and no approval: a firewall exception for listed Azure service types with a managed identity. Learn: &quot;isn't equivalent to a Private Link connection&quot;. Documented today for Foundry IQ ingestion-time embeddings and for same-region Blob indexers." style="fontSize=12;fontFamily=Segoe UI;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="560" y="725" width="570" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
