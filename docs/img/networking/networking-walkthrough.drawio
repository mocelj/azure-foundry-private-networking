rent="0"/><mxCell id="04-spoke-ready-1" value="Option C — Spoke-ready: deploy now, the network team connects later" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="30" as="geometry"/></mxCell><mxCell id="04-spoke-ready-2" value="Phase 1: isolated spoke, local zones, no route to anything (models only). Phase 2: peering + Switch-ToCentralDns.ps1 moves the PE DNS records into the central zones." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#605e5c;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1500" height="36" as="geometry"/></mxCell><mxCell id="04-spoke-ready-3" value="Phase 1 — isolated (after azd provision)" style="rounded=1;absoluteArcSize=1;arcSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fillColor=none;strokeColor=#8a8886;dashed=1;fontSize=13;fontStyle=1;fontColor=#605e5c;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="750" height="620" as="geometry"/></mxCell><mxCell id="04-spoke-ready-4" value="Spoke VNet 10.82.0.0/16 · DNS: Azure-provided" style="rounded=1;absoluteArcSize=1;arcSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fillColor=#eff6fc;strokeColor=#0078d4;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#004578;spacingLeft=46;" vertex="1" parent="1"><mxGeometry x="360" y="150" width="390" height="420" as="geometry"/></mxCell><mxCell id="04-spoke-ready-5" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Virtual_Networks.svg;fontSize=11;whiteSpace=nowrap;labelBackgroundColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="368" y="154" width="30" height="30" as="geometry"/></mxCell><mxCell id="04-spoke-ready-6" value="snet-private-endpoints 10.82.1.0/24" style="rounded=1;absoluteArcSize=1;arcSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fillColor=#ffffff;strokeColor=#71afe5;fontSize=12;fontColor=#004578;" vertex="1" parent="1"><mxGeometry x="380" y="200" width="350" height="140" as="geometry"/></mxCell><mxCell id="04-spoke-ready-7" value="PE account 10.82.1.4–.6" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Private_Endpoint.svg;fontSize=11;whiteSpace=nowrap;labelBackgroundColor=#ffffff;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="400" y="240" width="44" height="44" as="geometry"/></mxCell><mxCell id="04-spoke-ready-8" value="local zones (spoke RG)&lt;br&gt;linked to the spoke only" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/DNS_Zones.svg;fontSize=11;whiteSpace=nowrap;labelBackgroundColor=#ffffff;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="400" y="400" width="44" height="44" as="geometry"/></mxCell><mxCell id="04-spoke-ready-9" value="Nobody can reach the account:&lt;br&gt;• no peering, no route, no public IP&lt;br&gt;• public calls → 403&lt;br&gt;• in-VNet tests: SKIP (no client)" style="shape=note;size=12;fillColor=#fffbe6;strokeColor=#c8c6c4;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="50" y="200" width="280" height="110" as="geometry"/></mxCell><mxCell id="04-spoke-ready-10" value="&lt;b&gt;Peering alone isn't enough&lt;/b&gt;&lt;br&gt;hub DNS can't resolve the spoke's private endpoints until their records move to the &lt;i&gt;central&lt;/i&gt; zones (handover script, validated 30/30)" style="shape=note;size=12;fillColor=#fffbe6;strokeColor=#c8c6c4;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="50" y="340" width="280" height="110" as="geometry"/></mxCell><mxCell id="04-spoke-ready-11" value="PaaS (public access Disabled)" style="rounded=1;absoluteArcSize=1;arcSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fillColor=#f1faf1;strokeColor=#107c10;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#0b5a0b;" vertex="1" parent="1"><mxGeometry x="50" y="590" width="280" height="90" as="geometry"/></mxCell><mxCell id="04-spoke-ready-12" value="Foundry account" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/ai_machine_learning/AI_Foundry.svg;fontSize=11;whiteSpace=nowrap;labelBackgroundColor=#ffffff;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="70" y="615" width="40" height="40" as="geometry"/></mxCell><mxCell id="04-spoke-ready-13" value="Phase 2 — after handover" style="rounded=1;absoluteArcSize=1;arcSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fillColor=none;strokeColor=#8a8886;dashed=1;fontSize=13;fontStyle=1;fontColor=#605e5c;" vertex="1" parent="1"><mxGeometry x="790" y="100" width="750" height="620" as="geometry"/></mxCell><mxCell id="04-spoke-ready-14" value="Spoke VNet 10.82.0.0/16 · DNS servers: hub resolver" style="rounded=1;absoluteArcSize=1;arcSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fillColor=#eff6fc;strokeColor=#0078d4;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#004578;spacingLeft=46;" vertex="1" parent="1"><mxGeometry x="1130" y="150" width="390" height="420" as="geometry"/></mxCell><mxCell id="04-spoke-ready-15" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Virtual_Networks.svg;fontSize=11;whiteSpace=nowrap;labelBackgroundColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1138" y="154" width="30" height="30" as="geometry"/></mxCell><mxCell id="04-spoke-ready-16" value="snet-private-endpoints 10.82.1.0/24" style="rounded=1;absoluteArcSize=1;arcSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fillColor=#ffffff;strokeColor=#71afe5;fontSize=12;fontColor=#004578;" vertex="1" parent="1"><mxGeometry x="1150" y="200" width="350" height="140" as="geometry"/></mxCell><mxCell id="04-spoke-ready-17" value="PE account 10.82.1.4–.6" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Private_Endpoint.svg;fontSize=11;whiteSpace=nowrap;labelBackgroundColor=#ffffff;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1170" y="240" width="44" height="44" as="geometry"/></mxCell><mxCell id="04-spoke-ready-18" value="Hub (customer)" style="rounded=1;absoluteArcSize=1;arcSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fillColor=#f4f0fa;strokeColor=#5c2d91;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#32145a;" vertex="1" parent="1"><mxGeometry x="810" y="150" width="290" height="420" as="geometry"/></mxCell><mxCell id="04-spoke-ready-19" value="hub workstation" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/compute/Virtual_Machine.svg;fontSize=11;whiteSpace=nowrap;labelBackgroundColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="840" y="200" width="40" height="40" as="geometry"/></mxCell><mxCell id="04-spoke-ready-20" value="resolver 10.0.2.4" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/DNS_Private_Resolver.svg;fontSize=11;whiteSpace=nowrap;labelBackgroundColor=#ffffff;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="840" y="300" width="40" height="40" as="geometry"/></mxCell><mxCell id="04-spoke-ready-21" value="central zones&lt;br&gt;A &amp;lt;account&amp;gt; → 10.82.1.5" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/DNS_Zones.svg;fontSize=11;whiteSpace=nowrap;labelBackgroundColor=#ffffff;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="840" y="400" width="44" height="44" as="geometry"/></mxCell><mxCell id="04-spoke-ready-22" value="443 via peering" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;fontFamily=Segoe UI;strokeColor=#0078d4;strokeWidth=2;fontColor=#004578;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="04-spoke-ready-19" target="04-spoke-ready-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="04-spoke-ready-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;fontFamily=Segoe UI;strokeColor=#038387;strokeWidth=2;dashed=1;dashPattern=1 3;fontColor=#025a5c;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="04-spoke-ready-20" target="04-spoke-ready-21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="04-spoke-ready-24" value="&lt;b&gt;Switch-ToCentralDns.ps1&lt;/b&gt;&lt;br&gt;1 delete the PE's zone group (can't be re-pointed: &lt;i&gt;UpdatingPrivateDnsZoneIdOnPrivateDnsZoneConfigNotAllowed&lt;/i&gt;)&lt;br&gt;2 recreate it against the central zones → records written