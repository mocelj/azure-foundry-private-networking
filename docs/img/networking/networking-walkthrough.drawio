790"/><mxPoint x="236" y="444"/></Array></mxGeometry></mxCell><mxCell id="02-standalone-50" value="no allow rule (NSG&lt;br&gt;deny Internet)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;fontFamily=Segoe UI;strokeColor=#a4262c;strokeWidth=2;dashed=1;endArrow=cross;fontColor=#a4262c;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="02-standalone-17" target="02-standalone-7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="286" y="663"/><mxPoint x="286" y="682"/></Array></mxGeometry></mxCell><mxCell id="02-standalone-51" value="Egress through NAT: Entra sign-in and tokens, the portal SPA and platform endpoints (service tags in the agent NSG). Everything else outbound is denied by NSG. Not shown: Foundry resource logs → Log Analytics via diagnostic settings (Azure platform, no VNet path).&lt;br&gt;&lt;b&gt;Entra ID&lt;/b&gt;: public endpoint (Microsoft backbone), no private endpoint; token traffic only, no customer data. VM managed identities use IMDS (no egress)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1100" y="690" width="420" height="100" as="geometry"/></mxCell><mxCell id="02-standalone-52" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="900" width="60" height="20" as="geometry"/></mxCell><mxCell id="02-standalone-53" value="" style="shape=waypoint;fillColor=none;strokeColor=none;size=1;" vertex="1" parent="1"><mxGeometry x="80" y="910" width="1" height="1" as="geometry"/></mxCell><mxCell id="02-standalone-54" value="" style="shape=waypoint;fillColor=none;strokeColor=none;size=1;" vertex="1" parent="1"><mxGeometry x="126" y="910" width="1" height="1" as="geometry"/></mxCell><mxCell