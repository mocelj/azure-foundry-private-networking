<mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="05-managed-vnet-41" value="Account MI holds &lt;b&gt;Azure AI Enterprise Network Connection Approver&lt;/b&gt; on the RG: the managed network creates &lt;b&gt;and approves&lt;/b&gt; its private endpoint connections on your resources. Managed PEs are not NICs in your subscription; they appear as approved connections (requester in a Microsoft subscription) on the targets. No egress logs." style="shape=note;size=12;fillColor=#fffbe6;strokeColor=#c8c6c4;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1080" y="150" width="440" height="110" as="geometry"/></mxCell><mxCell id="05-managed-vnet-42" value="Internet / other endpoints" style="rounded=1;absoluteArcSize=1;arcSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fillColor=#fff4ce;strokeColor=#c19c00;fontSize=13;fontStyle=1;fontColor=#6d5700;" vertex="1" parent="1"><mxGeometry x="620" y="760" width="400" height="110" as="geometry"/></mxCell><mxCell id="05-managed-vnet-43" value="Any destination without an approved outbound rule&lt;br&gt;is denied; not visible in customer-side logs&lt;br&gt;in managed VNet" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/general/Globe.svg;fontSize=11;whiteSpace=nowrap;labelBackgroundColor=#ffffff;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="650" y="810" width="44" height="44" as="geometry"/></mxCell><mxCell id="05-managed-vnet-44" value="denied silently" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;fontFamily=Segoe UI;strokeColor=#a4262c;strokeWidth=2;dashed=1;endArrow=cross;fontColor=#a4262c;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;