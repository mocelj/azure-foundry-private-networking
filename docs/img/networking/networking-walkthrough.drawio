ra FQDNs" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Firewalls.svg;fontSize=11;whiteSpace=nowrap;labelBackgroundColor=#ffffff;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;spacingRight=4;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="430" y="415" width="40" height="40" as="geometry"/></mxCell><mxCell id="03-hub-spoke-16" value="snet-dns-inbound 10.0.2.0/28" style="rounded=1;absoluteArcSize=1;arcSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fillColor=#ffffff;strokeColor=#71afe5;fontSize=12;fontColor=#004578;" vertex="1" parent="1"><mxGeometry x="230" y="520" width="260" height="90" as="geometry"/></mxCell><mxCell id="03-hub-spoke-17" value="DNS Private Resolver&lt;br&gt;inbound 10.0.2.4" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/DNS_Private_Resolver.svg;fontSize=11;whiteSpace=nowrap;labelBackgroundColor=#ffffff;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;spacingRight=4;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="430" y="545" width="40" height="40" as="geometry"/></mxCell><mxCell id="03-hub-spoke-18" value="snet-hub-pe 10.0.5.0/24" style="rounded=1;absoluteArcSize=1;arcSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fillColor=#ffffff;strokeColor=#71afe5;fontSize=12;fontColor=#004578;" vertex="1" parent="1"><mxGeometry x="230" y="630" width="260" height="90" as="geometry"/></mxCell><mxCell id="03-hub-spoke-19" value="PE central AMPLS 10.0.5.4&lt;br&gt;(hub AMPLS)" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Private_Endpoint.svg;fontSize=11;whiteSpace=nowrap;labelBackgroundColor=#ffffff;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;spacingRight=4;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="430" y="655" width="