e="s7-dns-44" target="s7-dns-45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s7-dns-47" value="&lt;b&gt;6&lt;/b&gt;&amp;nbsp;443 via ER/VPN → hub → peering&lt;br&gt;&lt;font style='font-size:10px' color='#605e5c'&gt;spoke 10.81.0.0/16 + PE /32 routes&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=bottom;whiteSpace=wrap;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="148.0" y="434" width="984.0" height="34" as="geometry"/></mxCell><mxCell id="s7-dns-48" value="" style="shape=waypoint;fillColor=none;strokeColor=none;size=1;" vertex="1" parent="1"><mxGeometry x="1340.0" y="514" width="1" height="1" as="geometry"/></mxCell><mxCell id="s7-dns-49" value="" style="shape=waypoint;fillColor=none;strokeColor=none;size=1;" vertex="1" parent="1"><mxGeometry x="540.0" y="514" width="1" height="1" as="geometry"/></mxCell><mxCell id="s7-dns-50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;fontFamily=Segoe UI;strokeColor=#038387;strokeWidth=2;dashed=1;dashPattern=1 3;fontColor=#025a5c;jumpStyle=none;" edge="1" parent="1" source="s7-dns-48" target="s7-dns-49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s7-dns-51" value="&lt;b&gt;7&lt;/b&gt;&amp;nbsp;spoke VNet DNS server = 10.0.2.4 (same answer)" style="text;html=1;align=center;verticalAlign=bottom;whiteSpace=wrap;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="548.0" y="480" width="784.0" height="34" as="geometry"/></mxCell><mxCell id="s7-dns-52" value="" style="shape=waypoint;fillColor=none;strokeColor=none;size=1;" vertex="1" parent="1"><mxGeometry x="1340.0" y="560" width="1" height="1" as="geometry"/></mxCell><mxCell id="s7-dns-53" value="" style="shape=waypoint;fillColor=none;strokeColor=none;size=1;" vertex="1" parent="1"><mxGeometry x="1140.0" y="560" width="1" height="1" as="geometry"/></mxCell><mxCell id="s7-dns-54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;fontFamily=Segoe UI;strokeColor=#0078d4;strokeWidth=2;fontColor=#004578;jumpStyle=none;" edge="1" parent="1" source="s7-dns-52" target="s7-dns-53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s7-dns-55" value="&lt;b&gt;8&lt;/b&gt;&amp;nbsp;443 — peering / in-VNet route, not the firewall&lt;br&gt;&lt;font style='font-size:10px' color='#605e5c'&gt;/32 and /16 routes take priority over the 0.0.0.0/0 UDR&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=bottom;whiteSpace=wrap;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1100.0" y="526" width="280" height="34" as="geometry"/></mxCell><mxCell id="s7-dns-56" value="Forward the &lt;i&gt;public&lt;/i&gt; zone names (services.ai.azure.com, openai.azure.com, cognitiveservices.azure.com, search.windows.net …), not only privatelink.*, so clients follow the public CNAME into the private zone. Hub clients only get the private answer once the record is in the central zone (spoke-ready: peering alone isn't enough)." style="shape=note;size=12;fillColor=#fffbe6;strokeColor=#c8c6c4;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="50.0" y="580" width="980.0" height="44" as="geometry"/></mxCell><mxCell id="s7-dns-78" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="60" height="20" as="geometry"/></mxCell><mxCell id="s7-dns-79" value="" style="shape=waypoint;fillColor=none;strokeColor=none;size=1;" vertex="1" parent="1"><mxGeometry x="80" y="670" width="1" height="1" as="geometry"/></mxCell><mxCell id="s7-dns-80" value="" style="shape=waypoint;fillColor=none;strokeColor=none;size=1;" vertex="1" 