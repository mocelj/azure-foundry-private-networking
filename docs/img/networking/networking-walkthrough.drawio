<mxfile host="drawio" agent="draw.io"><diagram id="01-private-link-anatomy" name="Private Link anatomy"><mxGraphModel dx="1560" dy="870" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="870" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="01-private-link-anatomy-1" value="Private Link anatomy — one FQDN, two answers" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="30" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-2" value="The same name resolves to a private IP inside the VNet (zone linked) and to the public IP everywhere else. With publicNetworkAccess=Disabled only the private-endpoint path is accepted. Example: Option A (standalone)." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#605e5c;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1500" height="36" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-3" value="Your VNet 10.80.0.0/16" style="rounded=1;absoluteArcSize=1;arcSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fillColor=#eff6fc;strokeColor=#0078d4;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#004578;spacingLeft=46;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="780" height="450" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-4" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Virtual_Networks.svg;fontSize=11;whiteSpace=nowrap;labelBackgroundColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="28" y="104" width="30" height="30" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-5" value="snet-management 10.80.2.0/24" style="rounded=1;absoluteArcSize=1;arcSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fillColor=#ffffff;strokeColor=#71afe5;fontSize=12;fontColor=#004578;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="300" height="140" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-6" value="jumpbox 10.80.2.4" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/compute/Virtual_Machine.svg;fontSize=11;whiteSpace=nowrap;labelBackgroundColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="70" y="190" width="52" height="52" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-7" value="snet-private-endpoints 10.80.1.0/24" style="rounded=1;absoluteArcSize=1;arcSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fillColor=#ffffff;strokeColor=#71afe5;fontSize=12;fontColor=#004578;" vertex="1" parent="1"><mxGeometry x="440" y="150" width="340" height="140" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-8" value="PE &lt;b&gt;pe-&amp;lt;account&amp;gt;&lt;/b&gt; (group &lt;i&gt;account&lt;/i&gt;)&lt;br&gt;.17 cognitiveservices · .18 openai · .19 services.ai" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/Private_Endpoint.svg;fontSize=11;whiteSpace=nowrap;labelBackgroundColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="585" y="190" width="52" height="52" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-9" value="Azure-provided DNS&lt;br&gt;168.63.129.16" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/DNS_Zones.svg;fontSize=11;whiteSpace=nowrap;labelBackgroundColor=#ffffff;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="70" y="360" width="52" height="52" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-10" value="Private DNS zone &lt;b&gt;privatelink.openai.azure.com&lt;/b&gt;&lt;br&gt;linked to this VNet&lt;br&gt;A &amp;lt;account&amp;gt; → &lt;b&gt;10.80.1.18&lt;/b&gt;" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/networking/DNS_Zones.svg;fontSize=11;whiteSpace=nowrap;labelBackgroundColor=#ffffff;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="70" y="460" width="52" height="52" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-11" value="&lt;b&gt;DNS answer inside the VNet&lt;/b&gt;&lt;br&gt;&amp;lt;account&amp;gt;.openai.azure.com&lt;br&gt;→ CNAME &amp;lt;account&amp;gt;.privatelink.openai.azure.com&lt;br&gt;→ &lt;b&gt;A 10.80.1.18&lt;/b&gt; (from the linked zone)" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#ffffff;strokeColor=#c8c6c4;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="480" y="360" width="300" height="82" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-12" value="Microsoft Foundry (PaaS)" style="rounded=1;absoluteArcSize=1;arcSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fillColor=#f1faf1;strokeColor=#107c10;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#0b5a0b;" vertex="1" parent="1"><mxGeometry x="860" y="100" width="380" height="450" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-13" value="&lt;b&gt;&amp;lt;account&amp;gt;&lt;/b&gt;&lt;br&gt;publicNetworkAccess: &lt;b&gt;Disabled&lt;/b&gt;&lt;br&gt;networkAcls: Deny · local auth off" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/ai_machine_learning/AI_Foundry.svg;fontSize=11;whiteSpace=nowrap;labelBackgroundColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1020" y="190" width="52" height="52" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-14" value="Private endpoint connections&lt;br&gt;&lt;b&gt;pe-&amp;lt;account&amp;gt; : Approved&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#ffffff;strokeColor=#c8c6c4;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="880" y="350" width="330" height="44" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-15" value="Public endpoint &lt;b&gt;51.12.73.214&lt;/b&gt;&lt;br&gt;(regional front end, shared by many accounts)" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#ffffff;strokeColor=#c8c6c4;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="880" y="420" width="330" height="44" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-16" value="Internet" style="rounded=1;absoluteArcSize=1;arcSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fillColor=#fff4ce;strokeColor=#c19c00;fontSize=13;fontStyle=1;fontColor=#6d5700;" vertex="1" parent="1"><mxGeometry x="20" y="600" width="1220" height="210" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-17" value="laptop / any client&lt;br&gt;valid Entra token" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/identity/Users.svg;fontSize=11;whiteSpace=nowrap;labelBackgroundColor=#ffffff;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="52" height="52" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-18" value="public DNS" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/general/Globe.svg;fontSize=11;whiteSpace=nowrap;labelBackgroundColor=#ffffff;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="330" y="650" width="52" height="52" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-19" value="&lt;b&gt;DNS answer on the internet&lt;/b&gt;&lt;br&gt;&amp;lt;account&amp;gt;.openai.azure.com → CNAME &amp;lt;account&amp;gt;.privatelink.openai.azure.com&lt;br&gt;→ CNAME swedencentral.api.cognitive.microsoft.com → … Traffic Manager / API front end …&lt;br&gt;→ &lt;b&gt;A 51.12.73.214&lt;/b&gt; (the privatelink zone answers only inside linked VNets)" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#ffffff;strokeColor=#c8c6c4;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="520" y="640" width="600" height="80" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-20" value="1 DNS query" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;fontFamily=Segoe UI;strokeColor=#038387;strokeWidth=2;dashed=1;dashPattern=1 3;fontColor=#025a5c;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="01-private-link-anatomy-6" target="01-private-link-anatomy-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="01-private-link-anatomy-21" value="2 CNAME → linked zone → A" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;fontFamily=Segoe UI;strokeColor=#038387;strokeWidth=2;dashed=1;dashPattern=1 3;fontColor=#025a5c;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="01-private-link-anatomy-9" target="01-private-link-anatomy-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="01-private-link-anatomy-22" value="3 TCP 443, TLS SNI &amp;lt;account&amp;gt;.openai.azure.com" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;fontFamily=Segoe UI;strokeColor=#0078d4;strokeWidth=2;fontColor=#004578;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="01-private-link-anatomy-6" target="01-private-link-anatomy-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="01-private-link-anatomy-23" value="4 Private Link" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;fontFamily=Segoe UI;strokeColor=#107c10;strokeWidth=3;fontColor=#0b5a0b;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="01-private-link-anatomy-8" target="01-private-link-anatomy-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="01-private-link-anatomy-24" value="5 query" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;fontFamily=Segoe UI;strokeColor=#038387;strokeWidth=2;dashed=1;dashPattern=1 3;fontColor=#025a5c;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="01-private-link-anatomy-17" target="01-private-link-anatomy-18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="01-private-link-anatomy-25" value='6 HTTPS + valid token → 403 "Public access is disabled"' style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;fontFamily=Segoe UI;strokeColor=#a4262c;strokeWidth=2;dashed=1;endArrow=cross;fontColor=#a4262c;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="01-private-link-anatomy-17" target="01-private-link-anatomy-13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="86" y="790"/><mxPoint x="1225" y="790"/><mxPoint x="1225" y="160"/><mxPoint x="1046" y="160"/></Array></mxGeometry></mxCell><mxCell id="01-private-link-anatomy-26" value="&lt;b&gt;Why it works&lt;/b&gt;&lt;br&gt;• The PE is a NIC in your subnet; Azure injects a /32 system route per PE IP into the VNet and peered VNets.&lt;br&gt;• With public access disabled the service only accepts traffic arriving through an &lt;b&gt;approved&lt;/b&gt; private endpoint connection.&lt;br&gt;• DNS decides the path: the &lt;i&gt;privatelink&lt;/i&gt; CNAME exists in public DNS, but only a linked private zone answers it with the PE IP.&lt;br&gt;• No proxy and no SNAT on the way in: TLS terminates at the service, the client keeps its own identity (Entra token)." style="shape=note;size=12;fillColor=#fffbe6;strokeColor=#c8c6c4;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1270" y="100" width="270" height="360" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-27" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="830" width="60" height="20" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-28" value="" style="shape=waypoint;fillColor=none;strokeColor=none;size=1;" vertex="1" parent="1"><mxGeometry x="80" y="840" width="1" height="1" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-29" value="" style="shape=waypoint;fillColor=none;strokeColor=none;size=1;" vertex="1" parent="1"><mxGeometry x="126" y="840" width="1" height="1" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;fontFamily=Segoe UI;strokeColor=#0078d4;strokeWidth=2;fontColor=#004578;" edge="1" parent="1" source="01-private-link-anatomy-28" target="01-private-link-anatomy-29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="01-private-link-anatomy-31" value="client request (HTTPS 443)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="132" y="831" width="172.24" height="20" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-32" value="" style="shape=waypoint;fillColor=none;strokeColor=none;size=1;" vertex="1" parent="1"><mxGeometry x="320.24" y="840" width="1" height="1" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-33" value="" style="shape=waypoint;fillColor=none;strokeColor=none;size=1;" vertex="1" parent="1"><mxGeometry x="366.24" y="840" width="1" height="1" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;fontFamily=Segoe UI;strokeColor=#107c10;strokeWidth=3;fontColor=#0b5a0b;" edge="1" parent="1" source="01-private-link-anatomy-32" target="01-private-link-anatomy-33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="01-private-link-anatomy-35" value="Private Link (private endpoint)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="372.24" y="831" width="203.44" height="20" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-36" value="" style="shape=waypoint;fillColor=none;strokeColor=none;size=1;" vertex="1" parent="1"><mxGeometry x="591.6800000000001" y="840" width="1" height="1" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-37" value="" style="shape=waypoint;fillColor=none;strokeColor=none;size=1;" vertex="1" parent="1"><mxGeometry x="637.6800000000001" y="840" width="1" height="1" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;fontFamily=Segoe UI;strokeColor=#038387;strokeWidth=2;dashed=1;dashPattern=1 3;fontColor=#025a5c;" edge="1" parent="1" source="01-private-link-anatomy-36" target="01-private-link-anatomy-37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="01-private-link-anatomy-39" value="DNS query" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="643.6800000000001" y="831" width="66.16" height="20" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-40" value="" style="shape=waypoint;fillColor=none;strokeColor=none;size=1;" vertex="1" parent="1"><mxGeometry x="725.84" y="840" width="1" height="1" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-41" value="" style="shape=waypoint;fillColor=none;strokeColor=none;size=1;" vertex="1" parent="1"><mxGeometry x="771.84" y="840" width="1" height="1" as="geometry"/></mxCell><mxCell id="01-private-link-anatomy-42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;fontFamily=Segoe UI;strokeColor=#a4262c;strokeWidth=2;dashed=1;endArrow=cross;fontColor=#a4262c;" edge="1" parent="1" source="01-private-link-anatomy-40" target="01-private-link-anatomy-41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="01-private-link-anatomy-43" value="blocked" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="777.84" y="831" width="53.68" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="02-standalone" name