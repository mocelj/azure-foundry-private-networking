{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "principalType": { "value": "${AZURE_PRINCIPAL_TYPE=User}" },

    "networkMode": { "value": "${NETWORK_MODE=standalone}" },
    "publicAllowedIps": { "value": "${PUBLIC_ALLOWED_IPS=}" },
    "outboundNetworkMode": { "value": "${OUTBOUND_NETWORK_MODE=byoVnet}" },
    "networkAclsBypass": { "value": "${FOUNDRY_NETWORK_ACLS_BYPASS=AzureServices}" },
    "vnetAddressPrefix": { "value": "${VNET_ADDRESS_PREFIX=10.80.0.0/16}" },
    "peSubnetPrefix": { "value": "${PE_SUBNET_PREFIX=10.80.1.0/24}" },
    "managementSubnetPrefix": { "value": "${MANAGEMENT_SUBNET_PREFIX=10.80.2.0/24}" },
    "bastionSubnetPrefix": { "value": "${BASTION_SUBNET_PREFIX=10.80.3.0/26}" },
    "appSubnetPrefix": { "value": "${APP_SUBNET_PREFIX=}" },
    "integrationSubnetPrefix": { "value": "${INTEGRATION_SUBNET_PREFIX=}" },
    "agentSubnetPrefix": { "value": "${AGENT_SUBNET_PREFIX=10.80.6.0/24}" },
    "customDnsServers": { "value": "${CUSTOM_DNS_SERVERS=}" },

    "existingHubVnetId": { "value": "${EXISTING_HUB_VNET_ID=}" },
    "enableHubPeering": { "value": "${ENABLE_HUB_PEERING=false}" },
    "enableHubSidePeering": { "value": "${ENABLE_HUB_SIDE_PEERING=false}" },
    "useHubGateway": { "value": "${USE_HUB_GATEWAY=false}" },
    "hubFirewallPrivateIp": { "value": "${HUB_FIREWALL_PRIVATE_IP=}" },
    "hubAdminSourcePrefixes": { "value": "${HUB_ADMIN_SOURCE_PREFIXES=}" },
    "privateDnsZoneMode": { "value": "${PRIVATE_DNS_ZONE_MODE=create}" },
    "existingPrivateDnsZoneIds": { "value": "${EXISTING_PRIVATE_DNS_ZONE_IDS=}" },

    "enableBastion": { "value": "${ENABLE_BASTION=true}" },
    "enableJumpbox": { "value": "${ENABLE_JUMPBOX=true}" },
    "jumpboxVmSize": { "value": "${JUMPBOX_VM_SIZE=Standard_D2s_v5}" },
    "jumpboxAutoShutdownTime": { "value": "${JUMPBOX_AUTO_SHUTDOWN_UTC=1900}" },
    "grantJumpboxValidationRoles": { "value": "${GRANT_JUMPBOX_VALIDATION_ROLES=true}" },
    "privateClientPrincipalId": { "value": "${PRIVATE_CLIENT_PRINCIPAL_ID=}" },

    "projectName": { "value": "${FOUNDRY_PROJECT_NAME=private-demo}" },
    "modelFormat": { "value": "${MODEL_FORMAT=OpenAI}" },
    "modelName": { "value": "${MODEL_NAME=gpt-5.4-mini}" },
    "modelVersion": { "value": "${MODEL_VERSION=2026-03-17}" },
    "modelDeploymentType": { "value": "${MODEL_DEPLOYMENT_TYPE=DataZoneStandard}" },
    "modelCapacity": { "value": "${MODEL_CAPACITY=10}" },
    "agentSearchSku": { "value": "${AGENT_SEARCH_SKU=basic}" },
    "agentStorageSku": { "value": "${AGENT_STORAGE_SKU=Standard_ZRS}" },
    "agentStorageNetworkBypass": { "value": "${AGENT_STORAGE_NETWORK_BYPASS=AzureServices}" },
    "logRetentionDays": { "value": "${LOG_RETENTION_DAYS=30}" },
    "enableAiSearch": { "value": "${ENABLE_AI_SEARCH=false}" },
    "aiSearchSku": { "value": "${AI_SEARCH_SKU=basic}" },
    "aiSearchIndexName": { "value": "${AI_SEARCH_INDEX_NAME=contoso-policies}" },
    "enableAgentDemo": { "value": "${ENABLE_AGENT_DEMO=false}" },
    "enableFoundryIq": { "value": "${ENABLE_FOUNDRY_IQ=false}" },
    "foundryIqKnowledgeBaseName": { "value": "${FOUNDRY_IQ_KB_NAME=contoso-policies-kb}" },
    "foundryIqReasoning": { "value": "${FOUNDRY_IQ_REASONING=minimal}" },
    "enableAdvancedMonitoring": { "value": "${ENABLE_ADVANCED_MONITORING=false}" },
    "existingAmplsId": { "value": "${EXISTING_AMPLS_ID=}" },
    "monitorAlertEmail": { "value": "${MONITOR_ALERT_EMAIL=}" },
    "monitorPublicIngestion": { "value": "${MONITOR_PUBLIC_INGESTION=Disabled}" },
    "demoAgentName": { "value": "${DEMO_AGENT_NAME_INPUT=contoso-policy-agent}" },
    "enableHostedAgentDemo": { "value": "${ENABLE_HOSTED_AGENT_DEMO=false}" },
    "enableRagDemo": { "value": "${ENABLE_RAG_DEMO=false}" },
    "ragAppPort": { "value": "${RAG_APP_PORT=8443}" },
    "ragVmSize": { "value": "${RAG_VM_SIZE=Standard_D2s_v5}" }
  }
}
