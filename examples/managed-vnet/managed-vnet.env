# Sample 6 — Standalone with a Microsoft-managed VNet for agents (PREVIEW, irreversible per account).
# Agent runtime in a Microsoft-managed network, AllowOnlyApprovedOutbound, no FQDN rules (no managed firewall).
# Inbound unchanged: private endpoints, PNA disabled, Bastion + jumpbox. All optional modules enabled.
# docs/modules/managed-vnet.md
NETWORK_MODE=standalone
FOUNDRY_PROJECT_NAME=mvnet-demo
OUTBOUND_NETWORK_MODE=managedVnet
MANAGED_VNET_PREVIEW_ACK=true
ENABLE_BASTION=true
ENABLE_JUMPBOX=true
ENABLE_AI_SEARCH=true
AI_SEARCH_SKU=basic
ENABLE_RAG_DEMO=true
ENABLE_AGENT_DEMO=true
ENABLE_ADVANCED_MONITORING=true
ENABLE_FOUNDRY_IQ=true
RAG_APP_PORT=8443
VNET_ADDRESS_PREFIX=10.83.0.0/16
PE_SUBNET_PREFIX=10.83.1.0/24
MANAGEMENT_SUBNET_PREFIX=10.83.2.0/24
BASTION_SUBNET_PREFIX=10.83.3.0/26
APP_SUBNET_PREFIX=10.83.4.0/24
MODEL_NAME=gpt-5.4-mini
MODEL_VERSION=2026-03-17
MODEL_DEPLOYMENT_TYPE=DataZoneStandard
MODEL_CAPACITY=10