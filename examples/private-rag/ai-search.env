# Sample 4 — Private Foundry with AI Search (standalone + optional knowledge search module).
NETWORK_MODE=standalone
# Distinct project name per deployment (otherwise several 'private-demo' projects look identical in the portal)
FOUNDRY_PROJECT_NAME=standalone-demo
OUTBOUND_NETWORK_MODE=byoVnet
ENABLE_BASTION=true
ENABLE_JUMPBOX=true
ENABLE_AI_SEARCH=true
AI_SEARCH_SKU=basic
VNET_ADDRESS_PREFIX=10.80.0.0/16
PE_SUBNET_PREFIX=10.80.1.0/24
MANAGEMENT_SUBNET_PREFIX=10.80.2.0/24
BASTION_SUBNET_PREFIX=10.80.3.0/26
AGENT_SUBNET_PREFIX=10.80.6.0/24
MODEL_NAME=gpt-5.4-mini
MODEL_VERSION=2026-03-17
MODEL_DEPLOYMENT_TYPE=DataZoneStandard
MODEL_CAPACITY=10
