# Full demo + Foundry IQ LLM query planning (option A+): the knowledge base calls the model at query time
# over an approved shared private link (knowledge search -> Foundry, openai_account). docs/private-link-explained.md
NETWORK_MODE=standalone
FOUNDRY_PROJECT_NAME=standalone-demo
OUTBOUND_NETWORK_MODE=byoVnet
ENABLE_BASTION=true
ENABLE_JUMPBOX=true
ENABLE_AI_SEARCH=true
AI_SEARCH_SKU=basic
ENABLE_RAG_DEMO=true
ENABLE_AGENT_DEMO=true
ENABLE_ADVANCED_MONITORING=true
ENABLE_FOUNDRY_IQ=true
FOUNDRY_IQ_REASONING=low
RAG_APP_PORT=8443
VNET_ADDRESS_PREFIX=10.80.0.0/16
PE_SUBNET_PREFIX=10.80.1.0/24
MANAGEMENT_SUBNET_PREFIX=10.80.2.0/24
BASTION_SUBNET_PREFIX=10.80.3.0/26
APP_SUBNET_PREFIX=10.80.4.0/24
AGENT_SUBNET_PREFIX=10.80.6.0/24
MODEL_NAME=gpt-5.4-mini
MODEL_VERSION=2026-03-17
MODEL_DEPLOYMENT_TYPE=DataZoneStandard
MODEL_CAPACITY=10
