# Sample 7 — Public quick demo (NOT PRIVATE). Foundry data planes accept traffic from public networks,
# restricted to PUBLIC_ALLOWED_IPS when set. Entra-only (no keys), Basic agent setup (agent state in
# Microsoft-managed storage), no VNet / Bastion / jumpbox / private endpoints, no optional modules.
# For quick demos with synthetic data only - never for customer data. docs/public-quick-demo.md
NETWORK_MODE=public
PUBLIC_NETWORK_ACCESS_ACK=true
# PUBLIC_ALLOWED_IPS=<your public IPv4>   (set per environment, e.g. azd env set PUBLIC_ALLOWED_IPS 203.0.113.10)
FOUNDRY_PROJECT_NAME=public-demo
OUTBOUND_NETWORK_MODE=none
ENABLE_BASTION=false
ENABLE_JUMPBOX=false
MODEL_NAME=gpt-5.4-mini
MODEL_VERSION=2026-03-17
MODEL_DEPLOYMENT_TYPE=DataZoneStandard
MODEL_CAPACITY=10