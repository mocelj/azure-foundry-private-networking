# Sample 1 — Spoke-ready: minimal private Foundry (models only, no admin access path), prepared for later hub integration.
# No Bastion, no jumpbox, no peering, no public IPs. Handover runbook: docs/spoke-ready-handover.md
# Load:  Get-Content examples/hub-spoke/spoke-ready.env | % { if ($_ -match '^([^#=]+)=(.*)$') { azd env set $Matches[1] $Matches[2] } }
NETWORK_MODE=spoke-ready
# Distinct project name per deployment (otherwise several 'private-demo' projects look identical in the portal)
FOUNDRY_PROJECT_NAME=spokeready-demo
OUTBOUND_NETWORK_MODE=none
ENABLE_BASTION=false
ENABLE_JUMPBOX=false
VNET_ADDRESS_PREFIX=10.80.0.0/16
PE_SUBNET_PREFIX=10.80.1.0/24
MODEL_NAME=gpt-5.4-mini
MODEL_VERSION=2026-03-17
MODEL_DEPLOYMENT_TYPE=DataZoneStandard
MODEL_CAPACITY=10
